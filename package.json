{
	"name": "n8n-nodes-blogautomation",
	"version": "0.1.1",
	"description": "n8n nodes for Blog Automation: write blog articles with AI, manage ideas, schedule and publish to WordPress, and trigger workflows when articles are ready, published or failed.",
	"license": "MIT",
	"homepage": "https://blog-automation.com/?utm_source=n8n&utm_medium=integration&utm_campaign=n8n-plugin",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"blog automation",
		"blog",
		"ai writer",
		"wordpress",
		"content calendar"
	],
	"author": {
		"name": "SH Software Solution",
		"email": "info@blog-automation.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/shsoftwaresolutioncom/n8n-nodes-blogautomation.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "npm run build && node --test test/*.test.js",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/BlogAutomationApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/BlogAutomation/BlogAutomation.node.js",
			"dist/nodes/BlogAutomationTrigger/BlogAutomationTrigger.node.js",
			"dist/nodes/BlogAutomationWebhookTrigger/BlogAutomationWebhookTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.53.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
